{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=centralhub.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jfl": {
    "Enabled": true,
    "Port": 9090,
    "BindAddress": "0.0.0.0",
    "KeepAliveMinutes": 5,
    "AcceptUnknownPanels": true,
    "ReadOnly": false,
    "LogRawFrames": false
  },
  "AllowedHosts": "*"
}
